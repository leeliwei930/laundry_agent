# Laundry Monitoring Agent — server environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- AI model provider -------------------------------------------------------
# "bedrock" (default) or "openrouter"
MODEL_PROVIDER=openrouter

# --- OpenRouter (required if MODEL_PROVIDER=openrouter) ----------------------
OPENROUTER_AI_URL=https://openrouter.ai/api/v1
OPENROUTER_AI_MODEL_ID=anthropic/claude-sonnet-4.5
OPENROUTER_AI_API_KEY=replace-me

# --- AWS Bedrock (required if MODEL_PROVIDER=bedrock) ------------------------
# Application inference profile ARN, e.g.
# arn:aws:bedrock:ap-southeast-1:123456789012:application-inference-profile/abc123
APPLICATION_INFERENCE_PROFILE_ARN=
BEDROCK_REGION=ap-southeast-1
# AWS credentials for calling Bedrock from outside Lambda
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Cloudflare R2 storage (required) ----------------------------------------
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
# Format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://example-account.r2.cloudflarestorage.com
R2_BUCKET_NAME=security-camera-snapshots

# --- Logging (optional) -------------------------------------------------------
# DEBUG, INFO, WARNING (default), ERROR, CRITICAL
APP_DEBUG=INFO
